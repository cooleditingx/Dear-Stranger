<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Form</title>
</head>
<body>
    <form action="/new" method="POST">
        <label for="text">Message</label>
        <input type="text" name="text" id="text">
        <label for="user">User Name</label>
