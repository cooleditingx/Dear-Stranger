<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Message Board</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <nav class="nav">
        <h2 class="msgs-heading">Dear Stranger</h2>
        <button class="msgs-submit" onclick="window.location.href = '/new'">Add Message</button>
    </nav>
    <div class="cards">
        <% messages.forEach((message) => { %>
        <div class="front-card">
            <div class="img-con">
            <% if (message.imgid) { %>
                <img class="img" src="/img/<%= message.imgid %>" alt="img">
            <% } else { %>
                <img class="img" src="/img/placeholder.png" alt="no image">
            <% } %>
            </div>
            <p class="subtitle"> <%= message.message %> </p>
        </div>
        <% }) %>
    </div>
</body>
</html>